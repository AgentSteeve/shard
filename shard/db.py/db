"""SQLite schema, connection, init. FTS5 full-text index on email + domain."""

import sqlite3
from pathlib import Path
from contextlib import contextmanager

from shard.config import DB_PATH


SCHEMA = """
PRAGMA journal_mode = WAL;
PRAGMA synchronous = NORMAL;
PRAGMA foreign_keys = ON;

-- Every unique email, normalized to lowercase
CREATE TABLE IF NOT EXISTS emails (
    id          INTEGER PRIMARY KEY,
    email       TEXT NOT NULL UNIQUE,
    domain      TEXT NOT NULL,
    email_hash  TEXT NOT NULL UNIQUE
);
CREATE INDEX IF NOT EXISTS idx_emails_domain ON emails(domain);

-- Every credential row (email + password + source)
CREATE TABLE IF NOT EXISTS credentials (
    id           INTEGER PRIMARY KEY,
    email_id     INTEGER NOT NULL,
    password     TEXT,
    password_hash TEXT,
    source       TEXT,
    raw_line     TEXT,
    ingested_at  INTEGER NOT NULL DEFAULT (strftime('%s','now')),
    FOREIGN KEY(email_id) REFERENCES emails(id) ON DELETE CASCADE
);
CREATE INDEX IF NOT EXISTS idx_creds_email_id ON credentials(email_id);
CREATE INDEX IF NOT EXISTS idx_creds_source ON credentials(source);

-- Sources registry
CREATE TABLE IF NOT EXISTS sources (
    id         INTEGER PRIMARY KEY,
    name       TEXT NOT NULL UNIQUE,
    path       TEXT,
    line_count INTEGER DEFAULT 0,
    ingested_at INTEGER NOT NULL DEFAULT (strftime('%s','now'))
);

-- FTS5 virtual table over emails for prefix + typo-tolerant search
CREATE VIRTUAL TABLE IF NOT EXISTS emails_fts USING fts5(
    email,
    domain,
    content='emails',
    content_rowid='id',
    tokenize='unicode61 remove_diacritics 2'
);

-- Triggers to keep FTS in sync
CREATE TRIGGER IF NOT EXISTS emails_ai AFTER INSERT ON emails BEGIN
    INSERT INTO emails_fts(rowid, email, domain) VALUES (new.id, new.email, new.domain);
END;
CREATE TRIGGER IF NOT EXISTS emails_ad AFTER DELETE ON emails BEGIN
    INSERT INTO emails_fts(emails_fts, rowid, email, domain) VALUES('delete', old.id, old.email, old.domain);
END;
CREATE TRIGGER IF NOT EXISTS emails_au AFTER UPDATE ON emails BEGIN
    INSERT INTO emails_fts(emails_fts, rowid, email, domain) VALUES('delete', old.id, old.email, old.domain);
    INSERT INTO emails_fts(rowid, email, domain) VALUES (new.id, new.email, new.domain);
END;
"""


def connect(db_path: Path | None = None) -> sqlite3.Connection:
    """Open a connection with sane defaults."""
    path = db_path or DB_PATH
    conn = sqlite3.connect(str(path), timeout=30.0, isolation_level=None)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode = WAL")
    conn.execute("PRAGMA synchronous = NORMAL")
    conn.execute("PRAGMA temp_store = MEMORY")
    conn.execute("PRAGMA cache_size = -64000")  # 64 MB
    return conn


def init(db_path: Path | None = None) -> None:
    """Create schema if not present."""
    conn = connect(db_path)
    try:
        conn.executescript(SCHEMA)
    finally:
        conn.close()


@contextmanager
def cursor(db_path: Path | None = None):
    """Context manager yielding a cursor, auto-commit on success."""
    conn = connect(db_path)
    try:
        yield conn.cursor()
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()
